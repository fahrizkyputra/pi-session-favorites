{
  "name": "pi-session-favorites",
  "version": "0.1.0",
  "description": "Mark Pi sessions as favorites (★ in the session name) so /resume shows which ones to continue later.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "session",
    "favorite",
    "bookmark",
    "resume"
  ],
  "license": "MIT",
  "author": "Fahrizky Putra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fahrizkyputra/pi-session-favorites.git"
  },
  "homepage": "https://github.com/fahrizkyputra/pi-session-favorites#readme",
  "bugs": {
    "url": "https://github.com/fahrizkyputra/pi-session-favorites/issues"
  },
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/session-favorites.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e-rpc.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
